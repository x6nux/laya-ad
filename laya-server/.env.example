# Copy to .env and fill in the values below. Keep .env out of Git.
LAYA_ADMIN_USERNAME=admin
# Set a password of at least 10 characters, or use LAYA_ADMIN_PASSWORD_HASH instead.
LAYA_ADMIN_PASSWORD=''
# LAYA_ADMIN_PASSWORD_HASH='$argon2id$...'
LAYA_SESSION_HOURS=12
# LAYA_DEVICE=cpu

# ad-clf CPU 优化（可选；默认物理核数 ≈ 逻辑核一半）
# LAYA_CPU_THREADS=8
# LAYA_AD_BATCH=32
# LAYA_AD_BATCH_WINDOW_MS=15
